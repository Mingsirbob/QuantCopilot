# ============================================================================
# LLM Provider Configuration
# ============================================================================
LANGCHAIN_PROVIDER=deepseek
LANGCHAIN_MODEL_NAME=deepseek-chat
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI Configuration (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# Gateway uses OPENAI_API_KEY, OPENAI_BASE_URL and OPENAI_MODEL directly.
# OPENAI_MODEL=gpt-5.6-luna

# 同花顺 Fuyao MCP 密钥 (https://fuyao.aicubes.cn)
Financial-API-KEY=your_fuyao_api_key_here

# LLM Parameters
LANGCHAIN_TEMPERATURE=0.0
TIMEOUT_SECONDS=120
MAX_RETRIES=2

# S0 CLI/daemon network settings (environment variables have highest priority)
QUANTWF_HOST=127.0.0.1
QUANTWF_PORT=7437
QUANTWF_TIMEOUT_SECONDS=3
